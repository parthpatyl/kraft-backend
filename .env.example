# =====================================
# Kraft Your Trip — Environment Variables
# =====================================
# Copy to .env and fill in your values before starting the server.

# ── SMTP (Google Workspace) ──────────────────────────────────────────────────
# Prerequisites:
#   1. Enable 2FA on your Google account
#   2. Generate App Password at https://myaccount.google.com/apppasswords
#   3. Use that 16-char password below (spaces are OK)
GOOGLE_SMTP_HOST=smtp.gmail.com
GOOGLE_SMTP_PORT=587
GOOGLE_SMTP_USER=enquiries@yourkrafttrip.com
GOOGLE_SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Sender Identity ──────────────────────────────────────────────────────────
SMTP_FROM_NAME=Kraft Your Trip
SMTP_FROM_EMAIL=enquiries@yourkrafttrip.com
ADMIN_EMAIL=admin@yourkrafttrip.com

# ── Application ──────────────────────────────────────────────────────────────
APP_URL=http://localhost:5000
NODE_ENV=development
LOG_LEVEL=debug
PORT=5000

# ── Redis (required for email queue) ─────────────────────────────────────────
# Start with: docker run -d -p 6379:6379 redis:7-alpine
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Email Queue Retry ────────────────────────────────────────────────────────
MAX_RETRIES=3
RETRY_DELAY_MS=5000

# ── Database (existing) ──────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres@localhost:5432/kraft_your_trip
JWT_SECRET=your-jwt-secret-here
